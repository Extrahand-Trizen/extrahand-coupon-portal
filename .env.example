# Used by Vite dev proxy (server-side) — not required in the browser during `npm run dev`
VITE_COUPON_SERVICE_URL=http://localhost:4015
VITE_TASK_SERVICE_URL=http://localhost:4002
VITE_PAYMENT_SERVICE_URL=http://localhost:4009
VITE_SERVICE_AUTH_TOKEN=ExtraHand_Secure_Token_2024_MinLength32Chars_ChangeInProduction
VITE_ADMIN_USER_ID=coupon-portal

# Optional: set VITE_API_DIRECT=true to call services from the browser instead of the Vite proxy
# VITE_API_DIRECT=true
# When direct: browser must send VITE_SERVICE_AUTH_TOKEN and VITE_ADMIN_USER_ID; catalog uses VITE_TASK_SERVICE_URL
